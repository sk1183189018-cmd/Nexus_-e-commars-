import React from 'react';
import { nexusColors } from '../tokens/colors';
import { Button } from './Button';

interface EmptyStateProps {
  icon?: React.ReactNode;
  title: string;
  description?: string;
  actionLabel?: string;
  onAction?: () => void;
}

export const EmptyState: React.FC<EmptyStateProps> = ({
  icon,
  title,
  description,
  actionLabel,
  onAction,
}) => {
  return (
    <div
      style={{
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        justifyContent: 'center',
        textAlign: 'center',
        padding: '48px 24px',
      }}
    >
      {icon && (
        <div
          style={{
            width: '72px',
            height: '72px',
            borderRadius: '50%',
            background: nexusColors.primary[50],
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            marginBottom: '20px',
            color: nexusColors.primary[500],
          }}
        >
          {icon}
        </div>
      )}
      <h3
        style={{
          fontSize: '1.125rem',
          fontWeight: 700,
          color: nexusColors.neutral[900],
          marginBottom: '6px',
        }}
      >
        {title}
      </h3>
      {description && (
        <p
          style={{
            fontSize: '0.875rem',
            color: nexusColors.neutral[500],
            maxWidth: '340px',
            marginBottom: actionLabel ? '20px' : '0',
          }}
        >
          {description}
        </p>
      )}
      {actionLabel && onAction && (
        <Button variant="primary" size="md" onClick={onAction}>
          {actionLabel}
        </Button>
      )}
    </div>
  );
};

export default EmptyState;
